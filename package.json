{
  "name": "warp-regis",
  "description": "Stateless Cloudflare WARP device registrar for Cloudflare Workers: MASQUE and WireGuard modes, optional KV storage",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "cloudflare",
    "workers",
    "warp",
    "masque",
    "wireguard",
    "wrangler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evansrrr/warp-regis.git"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
